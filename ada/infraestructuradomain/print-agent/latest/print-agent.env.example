# Copia este archivo como print-agent.env y ajusta los valores.
# No commitear print-agent.env (está en .gitignore).

# Dispositivo de la impresora de etiquetas (GS-2406T)
# Linux:   /dev/usb/lp0  (ver con `ls /dev/usb/lp*` tras conectar la impresora)
# Windows: nombre exacto de la cola — ejecutar en PowerShell:
#          Get-Printer | Select-Object Name, PortName | Format-Table -Auto
#          y usar el valor de la columna Name, ej: Gainscha GS-2406T
LABEL_DEVICE=/dev/usb/lp0

# Dispositivo de la impresora de tickets (DIG-K200L) — rutas /print/ticket y /print/pdf
# Linux:   /dev/usb/lp1  (el nodo lpX depende del orden de detección del kernel)
# Windows: nombre exacto de la cola, ej: POS Printer 203DPI Series
TICKET_DEVICE=/dev/usb/lp1

# Nombre de la cola CUPS de la impresora de tickets (solo Linux, para /print/pdf via CUPS)
# Configurar con: sudo lpadmin -p DIG-K200L -E -v "usb://Gainscha/GA-E200I?serial=..." -m generic/POS_Printer.ppd.gz
TICKET_PRINTER_NAME=DIG-K200L

# Puerto HTTP del agente (no necesita abrirse en el router, solo en el firewall local)
PORT=5000

# Token de seguridad — el frontend debe enviarlo como: Authorization: Bearer <valor>
# Dejar vacío solo en desarrollo local (deja el endpoint sin protección)
AGENT_SECRET=cambia-esto

# Orígenes CORS permitidos. Usa * para cualquiera, o la URL exacta del frontend.
CORS_ORIGINS=*

# Ruta al ejecutable de Ghostscript (solo para /print/pdf).
# Linux:   dejar vacío — usa "gs" del PATH.
# Windows: dejar vacío para auto-detectar en C:\Program Files\gs\...\bin\gswin64c.exe
#          o especificar la ruta completa si está en una ubicación no estándar:
#          GS_BINARY=C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe
GS_BINARY=
