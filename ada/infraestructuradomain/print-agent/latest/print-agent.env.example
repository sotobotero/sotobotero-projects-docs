# Copia este archivo como print-agent.env y ajusta los valores.
# No commitear print-agent.env (está en .gitignore).

# Dispositivo USB de la impresora de etiquetas (GS-2406T)
# Linux: ver con `ls /dev/usb/lp*` tras conectar la impresora
# Windows: \\.\USB001  o  nombre en el spooler
LABEL_DEVICE=/dev/usb/lp0

# Dispositivo USB de la impresora de tickets (DIG-K200L) — rutas /print/ticket y /print/pdf
# El nodo lpX depende del orden de detección del kernel al conectar las impresoras.
# Ver nota en README sobre asignación estable con udev rules.
TICKET_DEVICE=/dev/usb/lp1

# Nombre de la cola CUPS de la impresora de tickets
# Usado por el driver Gainscha para impresión desde el browser (Ctrl+P / CUPS).
# Configurar con: sudo lpadmin -p DIG-K200L -E -v "usb://Gainscha/GA-E200I?serial=..." -m generic/POS_Printer.ppd.gz
TICKET_PRINTER_NAME=DIG-K200L

# Puerto HTTP del agente (no necesita abrirse en el router, solo en el firewall local)
PORT=5000

# Token de seguridad — el frontend debe enviarlo como: Authorization: Bearer <valor>
# Dejar vacío solo en desarrollo local (deja el endpoint sin protección)
AGENT_SECRET=cambia-esto

# Orígenes CORS permitidos. Usa * para cualquiera, o la URL exacta del frontend.
CORS_ORIGINS=*
